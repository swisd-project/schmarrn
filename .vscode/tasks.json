{
  // SCHMARRN DEV FLOOR — one server by default (2026-11-04, user call: two is confusing).
  // Task "Dev" → php -S on :8080. Serves public site, JSON API, live-page editor and the
  // dashboard at /_/ (built SPA from build/; run npm run build after fresh clone or on
  // dashboard changes).
  // Task "Dev: Dashboard UI" → Vite dev server on :5173 (npm run dev:app, proxies /bridge
  // to :8080). Opt-in ONLY for dashboard-UI work — it needs the PHP server running too.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev (php -S :8080)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Dev: Dashboard UI (vite :5173, opt-in)",
      "type": "shell",
      "command": "npm run dev:app",
      "isBackground": true,
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    }
  ]
}
