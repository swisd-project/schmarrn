# Schmarrn front controller rules.
# The root index.php dispatches: /api/* to the JSON core, everything else to the
# public serving engine. Law: ONLY whitelisted static dirs are servable as real
# files — every other real file or dir on disk is forbidden (no source, content,
# draft, config or governance leaks, whatever the host layout).

RewriteEngine On

# Real files ONLY in the public static whitelist (themes, api/assets, dashboard/ —
# the built SPA's home on the host — plugin assets, the dashboard shell itself and
# its _app bundle). Plugin CODE is never whitelisted: a direct hit on
# plugins/<name>/plugin.php must not execute. The front controller itself passes too.
RewriteCond %{REQUEST_URI} ^/?(themes|api/assets|dashboard)/ [OR]
RewriteCond %{REQUEST_URI} ^/?plugins/[a-z0-9-]+/assets/ [OR]
RewriteCond %{REQUEST_URI} ^/?_app/ [OR]
RewriteCond %{REQUEST_URI} ^/?dashboard\.html$ [OR]
RewriteCond %{REQUEST_URI} ^/?index\.php$
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Any other real file or directory: forbidden. No enumerating leaks — the
# whitelist decides, nothing else on disk exists for the visitor.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [F]

# /api/* → the JSON core via the root front controller.
RewriteRule ^api(/|$) index.php [L]

# /_ → the dashboard (login + management). The public site NEVER wears a login face;
# the built index.html from the SPA build is GitHub-Pages-only and must not be
# uploaded to an FTP host's root (DirectoryIndex would shadow index.php).
RewriteRule ^_+$ dashboard.html [L]

# Everything else → the public site.
RewriteRule ^ index.php [L]
