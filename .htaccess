# Schmarrn front controller rules.
# The root index.php dispatches: /api/* to the JSON core, everything else to the
# public serving engine. Law: ONLY whitelisted static dirs are servable as real
# files — every other real file or dir on disk is forbidden (no source, content,
# draft, config or governance leaks, whatever the host layout).

RewriteEngine On

# Real files ONLY in the public static whitelist (themes, api/assets, dashboard/ —
# the built SPA's home on the host). The front controller itself passes too.
RewriteCond %{REQUEST_URI} ^/?(themes|api/assets|dashboard)/ [OR]
RewriteCond %{REQUEST_URI} ^/?index\.php$
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Any other real file or directory: forbidden. No enumerating leaks — the
# whitelist decides, nothing else on disk exists for the visitor.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [F]

# /api/* → the JSON core via the root front controller.
RewriteRule ^api(/|$) index.php [L]

# Everything else → the public site.
RewriteRule ^ index.php [L]
