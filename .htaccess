# Schmarrn front controller rules.
# The root index.php dispatches: /bridge/* to the JSON core, everything else to the
# public serving engine. Law: ONLY whitelisted static dirs are servable as real
# files — every other real file or dir on disk is forbidden (no source, content,
# draft, config or governance leaks, whatever the host layout).

RewriteEngine On

# /_ is the dashboard's home (login + management) — the app is BUILT under that
# base path. The dir and everything real under it passes; the dir itself goes
# through mod_dir's DirectoryIndex (/_ → /_/ → its index.html). The public site
# NEVER wears a login face — this is the only door.
RewriteRule ^_(/|$) - [L]

# Real files ONLY in the public static whitelist (themes, api/assets — and plugin
# assets). Plugin CODE is never whitelisted: a direct hit on
# bridge/plugins/<name>/plugin.php must not execute. The front controller itself passes too.
RewriteCond %{REQUEST_URI} ^/?(bridge/assets|bridge/templates)/ [OR]
RewriteCond %{REQUEST_URI} ^/?bridge/plugins/[a-z0-9-]+/assets/ [OR]
RewriteCond %{REQUEST_URI} ^/?index\.php$
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Any other real file or directory: NOT a 403. A 403 would be an existence
# oracle — outside scanners could map drafts, unpublished pages and config
# names by telling 403 (exists) from 404 (doesn't). Everything non-whitelisted
# gets the same public 404 through the front controller, existing or not.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ index.php [L]

# /bridge/* → the JSON core via the root front controller.
RewriteRule ^bridge(/|$) index.php [L]

# Static assets get a modest cache law (mod_headers, guarded — shared hosts vary).
# One hour, must-revalidate: assets are NOT content-hashed, so longer caching
# would serve stale decks/themes after an FTP update.
<IfModule mod_headers.c>
  Header set Cache-Control "max-age=3600, must-revalidate" "expr=%{REQUEST_URI} =~ m#^/?(bridge/assets|bridge/templates)/# || %{REQUEST_URI} =~ m#^/?bridge/plugins/[a-z0-9-]+/assets/#"
  # Ware-authored active documents (an SVG or HTML riding in a theme's or a
  # plugin's assets — boundary audit B8, 2026-11-07) ride the media sandbox
  # law: a direct hit renders as a document but executes nothing on this
  # origin — no script, no same-origin reach. The file stays a perfectly good
  # <img>, CSS or JS source; core-owned assets are trusted and stay free.
  Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox" "expr=(%{REQUEST_URI} =~ m#^/?bridge/templates/# || %{REQUEST_URI} =~ m#^/?bridge/plugins/[a-z0-9-]+/assets/#) && %{REQUEST_URI} =~ m#\.(svg|html)$#"
  # Public-page header law. The API sets its own in PHP — scoped out here so
  # headers never double up. `set` (not `always`) keeps one value per table.
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN" "expr=%{REQUEST_URI} !~ m#^/bridge(/|$)#"
</IfModule>

# Everything else → the public site.
RewriteRule ^ index.php [L]
