{
  "name": "schmarrn-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,app -c blue,green \"php -S localhost:8080 index.php\" \"vite dev\"",
    "dev:app": "vite dev",
    "dev:api": "php -S localhost:8080 index.php",
    "build": "vite build",
    "build:fallback": "node scripts/build-fallback.mjs",
    "build:edit": "node scripts/build-edit.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "svelte": "^5.28.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "zod": "^3.24.0"
  },
  "dependencies": {
    "@swisd-project/mdms": "github:swisd-project/mdms#v0.1.9",
    "remark-directive": "^4.0.0"
  }
}
